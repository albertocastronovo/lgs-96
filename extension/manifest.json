{
  "manifest_version": 3,
  "name": "LGS-96",
  "version": "0.1.0",
  "description": "Flags LinkedIn job cards with salary-information status (Italian D.Lgs. 96/2026).",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/search-results/*"],
