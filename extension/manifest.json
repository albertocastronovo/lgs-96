{
  "manifest_version": 3,
  "name": "LGS-96",
  "version": "0.8.0",
  "description": "Flags LinkedIn job cards with salary-information status (Italian D.Lgs. 96/2026).",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LGS-96"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/routes.js", "src/salary-parser.js", "src/cache.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
