{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "version": "0.10.0",
  "description": "__MSG_extension_description__",
  "default_locale": "en",
  "permissions": ["storage"],
  "host_permissions": ["https://cloud-cache.invalid/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extension_action_title__"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "src/routes.js",
        "src/salary-parser.js",
        "src/cache.js",
        "src/cloud-cache.js",
        "src/localization.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
